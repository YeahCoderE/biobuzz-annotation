<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Camera screen -->
    <FrameLayout
        android:id="@+id/cameraScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/flash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="#FFFFFF" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill"
            android:paddingBottom="8dp"
            android:paddingEnd="16dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_gravity="bottom"
            android:background="#B314171C">

            <ImageButton
                android:id="@+id/shutter"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_shutter"
                android:contentDescription="@string/shutter" />

            <TextView
                android:id="@+id/settingsButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="24dp"
                android:contentDescription="@string/settings"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/text"
                android:textSize="30sp" />
        </FrameLayout>
    </FrameLayout>

    <!-- Pairing / permission screen -->
    <ScrollView
        android:id="@+id/pairScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/pairTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/pair_title"
                android:textColor="@color/accent"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pairHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/pair_help"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/primaryButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button"
                android:text="@string/pair_scan"
                android:textColor="#14171C"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/manualBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/pair_manual"
                    android:textColor="@color/dim"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/hostInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/pair_host_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:textColor="@color/text"
                    android:textColorHint="@color/dim" />

                <EditText
                    android:id="@+id/codeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/pair_code_hint"
                    android:importantForAutofill="no"
                    android:inputType="textVisiblePassword"
                    android:textColor="@color/text"
                    android:textColorHint="@color/dim" />

                <Button
                    android:id="@+id/connectButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pair_connect" />
            </LinearLayout>

            <TextView
                android:id="@+id/pairMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/warn"
                android:textSize="15sp" />

            <Button
                android:id="@+id/cancelButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/cancel"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
