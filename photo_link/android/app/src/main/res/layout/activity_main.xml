<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/panel"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabCamera"
            style="@style/NavTab"
            android:text="@string/tab_camera" />

        <TextView
            android:id="@+id/tabPhotos"
            style="@style/NavTab"
            android:text="@string/tab_photos" />

        <TextView
            android:id="@+id/tabStatus"
            style="@style/NavTab"
            android:text="@string/tab_status" />

        <TextView
            android:id="@+id/tabSettings"
            style="@style/NavTab"
            android:text="@string/tab_settings" />
    </LinearLayout>
</LinearLayout>
